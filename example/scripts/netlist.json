{
  "project": "Vantage V1 Lite",
  "version": "1.0",
  "date": "2026-03-31",
  "source_docs": [
    "07 Connectivity Diagram.pdf",
    "07 Connectivity Reference.pdf",
    "06 Component Dimensions.pdf"
  ],

  "power_rails": {
    "VBAT": { "voltage": "3.0-4.2V", "source": "Battery cell", "consumers": ["PMIC input", "DRV2605L direct"] },
    "VBUS": { "voltage": "5.0V", "source": "Pogo pins", "consumers": ["PMIC charge input"] },
    "VDD_1V8": { "voltage": "1.8V", "source": "PMIC buck", "consumers": ["nRF5340 core", "mics", "flash"] },
    "VDD_3V3": { "voltage": "3.3V", "source": "PMIC LDO", "consumers": ["I/O levels (optional)"] },
    "GND": { "type": "ground", "note": "Continuous GND plane on Layer 2" }
  },

  "components": {
    "U1": {
      "component": "SoC",
      "part_number": "nRF5340-QKAA",
      "package": "aQFN94",
      "body_mm": [7.0, 7.0, 0.85],
      "pads": 94,
      "library": "nordic-lib-kicad",
      "footprint": "Nordic:QFN-94-1EP_7x7mm_P0.5mm"
    },
    "U2": {
      "component": "Flash (16MB)",
      "part_number": "W25Q128JV",
      "package": "WSON-8",
      "body_mm": [6.0, 5.0, 0.80],
      "pads": 8,
      "library": "kicad-official",
      "footprint": "Package_SON:WSON-8-1EP_6x5mm_P1.27mm_EP3.4x4.3mm"
    },
    "U3": {
      "component": "PMIC",
      "part_number": "nPM1300",
