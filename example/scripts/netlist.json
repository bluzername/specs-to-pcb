        { "name": "GND", "type": "ground" }
      ],
      "routing": { "criticality": "MEDIUM", "crosses_flex": false, "note": "Wide traces for current" }
    },
    {
      "id": 24,
      "name": "UART (mfg only)",
      "from": "U1",
      "to": "J1",
      "bus_type": "UART",
      "nets": [
        { "name": "UART_TX", "type": "data", "speed": "115.2-921.6 kbaud" },
        { "name": "UART_RX", "type": "data", "speed": "115.2-921.6 kbaud", "optional": true }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": false, "note": "Debug only, optional" }
