      "nets": [
        { "name": "RF_MATCH", "type": "rf", "note": "L/C matching network, part of RF path" }
      ],
      "routing": { "criticality": "HIGH", "crosses_flex": false }
    },
    {
      "id": 16,
      "name": "LED Red",
      "from": "U1",
      "to": "D1",
      "bus_type": "GPIO PWM",
      "nets": [
        { "name": "LED_R", "type": "pwm", "speed": "kHz PWM" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": false }
    },
    {
      "id": 17,
      "name": "LED Green",
      "from": "U1",
      "to": "D1",
      "bus_type": "GPIO PWM",
      "nets": [
        { "name": "LED_G", "type": "pwm", "speed": "kHz PWM" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": false }
    },
    {
      "id": 18,
      "name": "LED Blue",
      "from": "U1",
      "to": "D1",
      "bus_type": "GPIO PWM",
      "nets": [
        { "name": "LED_B", "type": "pwm", "speed": "kHz PWM" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": false }
    },
    {
      "id": 19,
      "name": "Button",
      "from": "SW1",
      "to": "U1",
      "bus_type": "GPIO",
      "nets": [
        { "name": "BTN_IRQ", "type": "interrupt", "edge": "async" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": false }
    },
    {
      "id": 20,
      "name": "32MHz Crystal",
      "from": "U1",
      "to": "Y1",
      "bus_type": "Analog",
      "nets": [
        { "name": "XC1", "type": "crystal", "freq": "32 MHz" },
        { "name": "XC2", "type": "crystal", "freq": "32 MHz" }
      ],
      "routing": { "criticality": "HIGH", "crosses_flex": false, "note": "Within 5mm of SoC, guard ring ground, no routing under crystal" }
    },
    {
      "id": 21,
      "name": "32.768kHz Crystal",
      "from": "U1",
      "to": "Y2",
      "bus_type": "Analog",
      "nets": [
        { "name": "XL1", "type": "crystal", "freq": "32.768 kHz" },
        { "name": "XL2", "type": "crystal", "freq": "32.768 kHz" }
      ],
      "routing": { "criticality": "MEDIUM", "crosses_flex": false, "note": "Keep short" }
    },
    {
      "id": 22,
      "name": "Battery",
      "from": "BT1",
      "to": "U3",
      "bus_type": "DC Power",
      "nets": [
        { "name": "BATT_P", "type": "power", "voltage": "3.0-4.2V", "current": "500mA" },
        { "name": "BATT_N", "type": "ground" }
      ],
      "routing": { "criticality": "MEDIUM", "crosses_flex": false, "note": "Wide traces for current" }
    },
    {
      "id": 23,
      "name": "Charge Input",
      "from": "J1/J2",
      "to": "U3",
      "bus_type": "DC Power",
      "nets": [
