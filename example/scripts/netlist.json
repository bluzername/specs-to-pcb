  "pcb": {
    "type": "4-layer rigid-flex",
    "layers": [
      { "name": "F.Cu", "type": "signal", "note": "Signal + components" },
      { "name": "In1.Cu", "type": "power", "note": "GND plane (continuous)" },
      { "name": "In2.Cu", "type": "power", "note": "VDD power plane" },
      { "name": "B.Cu", "type": "signal", "note": "Signal + LRA pads" }
    ],
    "rigid_thickness_mm": 0.8,
    "flex_thickness_mm": 0.175,
    "rigid_sections": 3,
    "flex_sections": 2,
    "estimated_length_mm": 50,
    "estimated_width_mm": 19,
    "flex_length_mm": 6.5
  }
}
