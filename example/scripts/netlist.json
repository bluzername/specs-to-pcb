  "interfaces": [
    {
      "id": 1,
      "name": "PDM Audio (M1)",
      "from": "U1",
      "to": "M1",
      "bus_type": "PDM",
      "nets": [
        { "name": "PDM_CLK", "type": "clock", "speed": "0.768-4.8 MHz", "note": "Shared with M2" },
        { "name": "PDM_DIN", "type": "data", "speed": "0.768-4.8 MHz", "note": "Shared with M2 - L/R demux by clock edge" }
      ],
      "routing": { "criticality": "HIGH", "length_match_mm": 2, "crosses_flex": true }
    },
    {
      "id": 2,
      "name": "PDM Audio (M2)",
      "from": "U1",
      "to": "M2",
      "bus_type": "PDM",
      "nets": [
        { "name": "PDM_CLK", "type": "clock", "speed": "0.768-4.8 MHz", "note": "Shared with M1" },
        { "name": "PDM_DIN", "type": "data", "speed": "0.768-4.8 MHz", "note": "Shared with M1 - L/R demux by clock edge" }
      ],
      "routing": { "criticality": "HIGH", "length_match_mm": 2, "crosses_flex": true }
    },
    {
      "id": 3,
      "name": "M1 Power",
      "from": "U3",
      "to": "M1",
      "bus_type": "DC Power",
      "nets": [
        { "name": "VDD_MIC", "type": "power", "voltage": "1.8V" },
        { "name": "GND", "type": "ground" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": true }
    },
    {
      "id": 4,
      "name": "M1 Config",
      "from": "U1",
      "to": "M1",
      "bus_type": "GPIO",
      "nets": [
        { "name": "MIC1_LR_SEL", "type": "static" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": true }
    },
    {
      "id": 5,
      "name": "M2 Power",
      "from": "U3",
      "to": "M2",
      "bus_type": "DC Power",
      "nets": [
        { "name": "VDD_MIC", "type": "power", "voltage": "1.8V" },
        { "name": "GND", "type": "ground" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": true }
    },
    {
      "id": 6,
      "name": "M2 Config",
      "from": "U1",
      "to": "M2",
      "bus_type": "GPIO",
      "nets": [
        { "name": "MIC2_LR_SEL", "type": "static" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": true }
    },
    {
      "id": 7,
      "name": "QSPI Flash",
      "from": "U1",
      "to": "U2",
      "bus_type": "QSPI",
      "nets": [
        { "name": "QSPI_CLK", "type": "clock", "speed": "32-96 MHz" },
        { "name": "QSPI_CS", "type": "chip_select" },
        { "name": "QSPI_IO0", "type": "data", "speed": "32-96 MHz" },
        { "name": "QSPI_IO1", "type": "data", "speed": "32-96 MHz" },
        { "name": "QSPI_IO2", "type": "data", "speed": "32-96 MHz" },
        { "name": "QSPI_IO3", "type": "data", "speed": "32-96 MHz" }
      ],
      "routing": { "criticality": "HIGH", "length_match_mm": 5, "crosses_flex": false, "note": "Place flash close to SoC, center zone" }
    },
    {
      "id": 8,
      "name": "PMIC Control",
      "from": "U1",
      "to": "U3",
      "bus_type": "I2C",
      "nets": [
        { "name": "I2C_SCL", "type": "clock", "speed": "100-400 kHz" },
        { "name": "I2C_SDA", "type": "data", "speed": "100-400 kHz" }
      ],
      "routing": { "criticality": "MEDIUM", "crosses_flex": false }
    },
    {
      "id": 9,
      "name": "PMIC Interrupt",
      "from": "U3",
      "to": "U1",
      "bus_type": "GPIO",
      "nets": [
        { "name": "PMIC_IRQ", "type": "interrupt", "active": "low" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": false }
    },
    {
      "id": 10,
      "name": "PMIC Ship/Hold",
      "from": "U1",
      "to": "U3",
      "bus_type": "GPIO",
      "nets": [
        { "name": "PMIC_SHPHLD", "type": "control", "active": "low" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": false }
    },
    {
      "id": 11,
      "name": "Haptic Control",
      "from": "U1",
      "to": "U4",
      "bus_type": "I2C",
      "nets": [
        { "name": "I2C_SCL", "type": "clock", "speed": "100-400 kHz", "note": "Shared bus with PMIC" },
        { "name": "I2C_SDA", "type": "data", "speed": "100-400 kHz", "note": "Shared bus with PMIC" }
      ],
      "routing": { "criticality": "MEDIUM", "crosses_flex": false }
    },
    {
      "id": 12,
      "name": "Haptic Enable",
      "from": "U1",
      "to": "U4",
      "bus_type": "GPIO",
      "nets": [
        { "name": "DRV_EN", "type": "enable" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": false }
    },
    {
      "id": 13,
      "name": "Haptic Drive",
      "from": "U4",
      "to": "H1",
      "bus_type": "Analog",
      "nets": [
        { "name": "LRA_OUT_P", "type": "analog", "freq": "150-250 Hz" },
        { "name": "LRA_OUT_N", "type": "analog", "freq": "150-250 Hz" }
      ],
      "routing": { "criticality": "LOW", "crosses_flex": false, "note": "Short run, center zone" }
    },
    {
      "id": 14,
      "name": "BLE RF",
      "from": "U1",
      "to": "ANT1",
      "bus_type": "RF",
      "nets": [
        { "name": "RF_ANT", "type": "rf", "impedance_ohm": 50, "freq": "2.4 GHz" }
      ],
      "routing": { "criticality": "HIGH", "crosses_flex": false, "note": "50 ohm controlled impedance, no vias, center to edge" }
    },
    {
      "id": 15,
      "name": "Antenna Match",
      "from": "ANT1",
      "to": "FL1/FL2",
